    "Ta collection AnkiWeb a été remplacée par une synchronisation complète faite ailleurs : %lld modification faite ici ne peut pas être fusionnée. « Retélécharger la collection » repart de la version d'AnkiWeb." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your AnkiWeb collection was replaced by a full sync made elsewhere: %lld change made here can't be merged. “Redownload the collection” starts again from AnkiWeb's version."
          }
        }
      }
    },
    "Ta collection AnkiWeb a été remplacée par une synchronisation complète faite ailleurs : %lld modifications faites ici ne peuvent pas être fusionnées. « Retélécharger la collection » repart de la version d'AnkiWeb." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your AnkiWeb collection was replaced by a full sync made elsewhere: %lld changes made here can't be merged. “Redownload the collection” starts again from AnkiWeb's version."
          }
        }
      }
    },
